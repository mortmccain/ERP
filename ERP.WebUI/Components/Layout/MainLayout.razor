@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Radzen.Blazor
@inject NavigationManager Navigation
@inject Radzen.ThemeService ThemeService
@inject IJSRuntime JSRuntime

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.SpaceBetween"
                     AlignItems="AlignItems.Center"
                     class="w-100 px-3">

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center" Gap="0.5rem">
                @* Hamburger — toggles sidebarExpanded which is bound to RadzenSidebar below *@
                <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
                <RadzenText TextStyle="TextStyle.H5" TagName="TagName.Span">ERP System</RadzenText>
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal"
                         Gap="0.5rem" AlignItems="AlignItems.Center">
                <RadzenDropDown TValue="string"
                                Value="@selectedTheme"
                                ValueChanged="@ChangeTheme"
                                Data="@freeThemeList"
                                Style="width: 140px;" />
                <RadzenBadge Text="@roleBadgeText" BadgeStyle="@roleBadgeStyle" />
                <RadzenText TextStyle="TextStyle.Body2">@displayName</RadzenText>
                <RadzenButton Text="Logout" ButtonStyle="ButtonStyle.Secondary"
                              Size="ButtonSize.Small" Click="Logout" />
            </RadzenStack>

        </RadzenStack>
    </RadzenHeader>

    @* @bind-Expanded wires the sidebar open/closed state to sidebarExpanded *@
    <RadzenSidebar @bind-Expanded="@sidebarExpanded">
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Dashboard" Icon="dashboard" Path="/" Match="NavLinkMatch.All" />
            <RadzenPanelMenuItem Text="Sales" Icon="shopping_cart" Path="/sales" Match="NavLinkMatch.All" />
            <RadzenPanelMenuItem Text="New Sale" Icon="add_shopping_cart" Path="/sales/create" />
            <RadzenPanelMenuItem Text="Customers" Icon="people" Path="/customers" />
            <AuthorizeView Roles="Admin,Manager">
                <RadzenPanelMenuItem Text="User Management" Icon="manage_accounts" Path="/admin/users" />
            </AuthorizeView>
        </RadzenPanelMenu>
    </RadzenSidebar>

    <RadzenBody>
        <RadzenContent Container="ContainerType.Fluid">
            @Body
        </RadzenContent>
    </RadzenBody>
</RadzenLayout>

<RadzenDialog />
<RadzenNotification  />
@* <style>
    .rz-message-container 
    {
        top: 8px !important;
    }
</style> *@

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool sidebarExpanded = true;
    private string displayName = string.Empty;
    private string roleBadgeText = string.Empty;
    private BadgeStyle roleBadgeStyle = BadgeStyle.Light;

    private string selectedTheme = "standard-dark";
    private readonly List<string> freeThemeList = new()
    {
        "standard", "standard-dark",
        "material", "material-dark",
        "humanistic", "humanistic-dark",
        "software", "software-dark",
        "dark", "default"
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        var user = authState.User;

        displayName = user.FindFirst("FullName")?.Value
                      ?? user.Identity?.Name
                      ?? "Unknown";

        if (user.IsInRole("Admin"))
        {
            roleBadgeText = "Admin";
            roleBadgeStyle = BadgeStyle.Danger;
        }
        else if (user.IsInRole("Manager"))
        {
            roleBadgeText = "Manager";
            roleBadgeStyle = BadgeStyle.Warning;
        }
        else if (user.IsInRole("Employee"))
        {
            roleBadgeText = "Employee";
            roleBadgeStyle = BadgeStyle.Info;
        }
        else
        {
            roleBadgeText = "Boss Man (ReadOnly)";
            roleBadgeStyle = BadgeStyle.Info;
        }

        // Restore saved theme preference
        try
        {
            var savedTheme = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "radzen_theme");
            if (!string.IsNullOrEmpty(savedTheme) && freeThemeList.Contains(savedTheme))
                selectedTheme = savedTheme;

            ThemeService.SetTheme(selectedTheme);
        }
        catch
        {
            ThemeService.SetTheme(selectedTheme);
        }
    }

    private async Task ChangeTheme(string theme)
    {
        selectedTheme = theme;
        ThemeService.SetTheme(theme);
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "radzen_theme", theme);
    }

    private void Logout() => Navigation.NavigateTo("/Account/Logout", forceLoad: true);
}