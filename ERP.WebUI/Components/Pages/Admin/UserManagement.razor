@page "/admin/users"
@attribute [Authorize(Roles = "Admin,Manager")]

@implements IAsyncDisposable



@using ERP.Application.Users.DTOs
@using ERP.Application.Users.Queries.GetAllUsers
@using ERP.Application.Users.Commands.CreateUser
@using ERP.Application.Users.Commands.DeleteUser
@using ERP.SharedKernel.Common
@using Wolverine
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR
@using System.Security.Claims

@inject IMessageBus MessageBus
@inject Radzen.NotificationService NotificationService
@inject Radzen.DialogService DialogService
@inject Microsoft.AspNetCore.SignalR.IHubContext<ERP.WebUI.Hubs.NotificationHub> HubContext
@inject IJSRuntime JS

<PageTitle>User Management - ERP</PageTitle>

<RadzenText TextStyle="TextStyle.H4" class="mb-4">
    User Management
</RadzenText>

<div class="row">

    <!-- CREATE USER -->
    <div class="col-md-5">
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.H6" class="mb-3">
                Create New User
            </RadzenText>

            <RadzenTemplateForm TItem="CreateUserModel" Data="@newUser" Submit="CreateUser">
                <RadzenStack Gap="1rem">

                    @if (formErrors.Count > 0)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">
                            <ul>
                                @foreach (var e in formErrors)
                                {
                                    <li>@e</li>
                                }
                            </ul>
                        </RadzenAlert>
                    }

                    <RadzenTextBox @bind-Value="newUser.Username" Placeholder="Username" />
                    <RadzenTextBox @bind-Value="newUser.Email" Placeholder="Email" />
                    <RadzenTextBox @bind-Value="newUser.FullName" Placeholder="Full Name" />
                    <RadzenPassword @bind-Value="newUser.Password" Placeholder="Password" />

                    @if (isAdmin)
                    {
                        <RadzenDropDown @bind-Value="newUser.Role"
                                        Data="@roles"
                                        Placeholder="Select Role" />
                    }
                    else
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Info">
                            Managers can only create Employee accounts.
                        </RadzenAlert>
                    }

                    <RadzenButton Text="Create User"
                                  ButtonType="ButtonType.Submit"
                                  ButtonStyle="ButtonStyle.Primary" />
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    </div>

    <!-- USER LIST -->
    <div class="col-md-7">
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.H6" class="mb-3">
                Users
            </RadzenText>

            <RadzenDataGrid Data="@users" AllowPaging="true" PageSize="10">

                <Columns>
                    <RadzenDataGridColumn Property="Username" Title="Username" />
                    <RadzenDataGridColumn Property="Email" Title="Email" />

                    <RadzenDataGridColumn Title="Roles">
                        <Template Context="u">
                            @string.Join(", ", u.Roles)
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Title="" Width="45px">
                        <Template Context="u">

                            <RadzenButton Icon="delete_forever"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Size="ButtonSize.Small"
                                          Disabled="@(u.Id == currentUserId)"
                                          Click="@(() => ConfirmDelete(u))" />

                        </Template>
                    </RadzenDataGridColumn>

                </Columns>

            </RadzenDataGrid>
        </RadzenCard>
    </div>
</div>

@code {

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; }

    private List<UserDto> users = new();
    private CreateUserModel newUser = new();
    private List<string> roles = new();
    private List<string> formErrors = new();
    private IReadOnlyList<string> currentUserRoles = Array.Empty<string>();
    private Guid currentUserId;
    private bool isAdmin;
    private bool isManager;

    private DotNetObjectReference<object>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateTask;
        var user = auth.User;

        isAdmin = user.IsInRole("Admin");
        isManager = user.IsInRole("Manager");

        if (Guid.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id))
            currentUserId = id;

        var rolesList = new List<string>();
        if (isAdmin) rolesList.Add("Admin");
        if (isManager) rolesList.Add("Manager");
        if (user.IsInRole("Employee")) rolesList.Add("Employee");
        if (user.IsInRole("ReadOnly")) rolesList.Add("ReadOnly");
        currentUserRoles = rolesList.AsReadOnly();

        roles = isAdmin
            ? new() { "Admin", "Manager", "Employee", "ReadOnly" }
            : new() { "Employee" };

        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        var query = new GetAllUsersQuery
        {
            RequestedByUserId = currentUserId,
            UserRoles = currentUserRoles
        };

        var result = await MessageBus.InvokeAsync<Result<List<UserDto>>>(query);

        if (result.IsSuccess)
            users = result.Value;
        else
            NotificationService.Notify(new() { Severity = NotificationSeverity.Error, Summary = "Error", Detail = result.Error });
    }

    private async Task CreateUser()
    {
        formErrors.Clear();

        if (string.IsNullOrWhiteSpace(newUser.Username))
            formErrors.Add("Username required");
        if (string.IsNullOrWhiteSpace(newUser.Password))
            formErrors.Add("Password required");

        if (formErrors.Count > 0)
            return;

        var command = new CreateUserCommand
        {
            Username = newUser.Username,
            Email = newUser.Email,
            FullName = newUser.FullName,
            Password = newUser.Password,
            Role = isManager ? "Employee" : newUser.Role,   // enforce manager restriction
            RequestedByUserId = currentUserId,
            UserRoles = currentUserRoles
        };

        var result = await MessageBus.InvokeAsync<Result>(command);

        if (result.IsSuccess)
        {
            NotificationService.Notify(new()
            {
                Severity = NotificationSeverity.Success,
                Summary = "User created",
                Detail = $"'{newUser.FullName}' has been added successfully.",
                Duration = 4000
            });
            newUser = new();
            await LoadUsers();
            await HubContext.Clients.All.SendAsync("RefreshData", "Users");
        }
        else
        {
            formErrors.Add(result.Error ?? "Failed to create user.");
        }
    }

    private async Task ConfirmDelete(UserDto user)
    {
        if (user.Id == currentUserId)
        {
            NotificationService.Notify(new()
            {
                Severity = NotificationSeverity.Error,
                Summary = "Blocked",
                Detail = "Cannot delete self"
            });
            return;
        }

        var confirmed = await DialogService.Confirm(
            $"Are you sure you want to permanently delete '{user.Username}'? This action cannot be undone.",
            "Delete User",
            new ConfirmOptions
            {
                OkButtonText = "Delete",
                CancelButtonText = "Cancel",
                CloseDialogOnEsc = true
            });

        if (confirmed == true)
        {
            await DeleteUser(user.Id);
        }
    }

    private async Task DeleteUser(Guid userId)
    {
        var command = new DeleteUserCommand
        {
            UserId = userId,
            RequestedByUserId = currentUserId,
            UserRoles = currentUserRoles
        };

        var result = await MessageBus.InvokeAsync<Result>(command);

        if (result.IsSuccess)
        {
            await LoadUsers();
            await HubContext.Clients.All.SendAsync("RefreshData", "Users");
        }
        else
        {
            NotificationService.Notify(new()
            {
                Severity = NotificationSeverity.Error,
                Summary = "Delete failed",
                Detail = result.Error
            });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create<object>(this);
            await JS.InvokeVoidAsync("connectToHub", _dotNetRef, "/notificationHub", "OnDataRefresh");
        }
    }

    [JSInvokable]
    public async Task OnDataRefresh(string dataType)
    {
        if (dataType == "Users")
        {
            await LoadUsers();
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
    }

    private class CreateUserModel
    {
        public string Username { get; set; }
        public string Email { get; set; }
        public string FullName { get; set; }
        public string Password { get; set; }
        public string Role { get; set; }
    }
}