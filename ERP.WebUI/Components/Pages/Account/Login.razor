@page "/Account/Login"
@layout LoginLayout
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser<Guid>> SignInManager
@inject NavigationManager Navigation

<PageTitle>Sign In - ERP</PageTitle>

<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center;
    background-color: var(--rz-ground-3);">

    <div style="width: 100%; max-width: 400px; padding: 1.5rem;">

        @* ── Branding ── *@
        <RadzenStack AlignItems="AlignItems.Center" Gap="0.4rem" class="mb-4">
            <div style="width: 60px; height: 60px; border-radius: 16px;
                background: var(--rz-primary);
                display: flex; align-items: center; justify-content: center;
                box-shadow: 0 4px 20px rgba(0,0,0,0.35);">
                <RadzenIcon Icon="inventory_2" style="font-size: 30px; color: white;" />
            </div>
            <span style="font-size: 1.4rem; font-weight: 700;
                color: var(--rz-text-color); margin-top: 0.35rem; letter-spacing: -0.3px;">
                ERP System
            </span>
            <span style="font-size: 12px; color: var(--rz-text-secondary-color); letter-spacing: .05em;">
                ENTERPRISE RESOURCE PLANNING
            </span>
        </RadzenStack>

        @* ── Card ── *@
        <RadzenCard style="padding: 2rem; border-radius: 12px;">

            <span style="display: block; font-size: 1.1rem; font-weight: 600;
                color: var(--rz-text-color); margin-bottom: 1.5rem;">
                Welcome back
            </span>


            <form method="post" @formname="login" @onsubmit="HandleLogin">
                <AntiforgeryToken />
                <RadzenStack Gap="1rem">

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">
                            <RadzenStack Orientation="Orientation.Horizontal"
                                         AlignItems="AlignItems.Center" Gap="0.4rem">
                                <RadzenIcon Icon="error_outline"
                                            style="font-size: 18px; flex-shrink: 0;" />
                                <span style="font-size: 13px;">@errorMessage</span>
                            </RadzenStack>
                        </RadzenAlert>
                    }

                    <div>
                        <label style="display: block; font-size: 12px; font-weight: 600;
                            text-transform: uppercase; letter-spacing: .06em;
                            color: var(--rz-text-secondary-color); margin-bottom: 6px;">
                            Username
                        </label>
                        <input type="text"
                               name="Username"
                               value="@Username"
                               class="rz-textbox"
                               style="width: 100%;"
                               autocomplete="username"
                               placeholder="your.username" />
                    </div>

                    <div>
                        <label style="display: block; font-size: 12px; font-weight: 600;
                            text-transform: uppercase; letter-spacing: .06em;
                            color: var(--rz-text-secondary-color); margin-bottom: 6px;">
                            Password
                        </label>
                        <input type="password"
                               name="Password"
                               class="rz-textbox"
                               style="width: 100%;"
                               autocomplete="current-password"
                               placeholder="••••••••" />
                    </div>

                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <input type="checkbox"
                               name="RememberMe"
                               value="true"
                               id="rememberMe"
                               style="width: 15px; height: 15px; cursor: pointer;
                        accent-color: var(--rz-primary); flex-shrink: 0;" />
                        <label for="rememberMe"
                               style="font-size: 13px; cursor: pointer;
                            color: var(--rz-text-secondary-color);">
                            Keep me signed in
                        </label>
                    </div>

                    <RadzenButton Text="Sign In"
                                  ButtonType="ButtonType.Submit"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Icon="login"
                                  Style="width: 100%; margin-top: 0.4rem;"
                                  Size="ButtonSize.Large" />

                </RadzenStack>
            </form>
        </RadzenCard>

        <div style="text-align: center; margin-top: 1.5rem;
            font-size: 11px; color: var(--rz-text-secondary-color);">
            © @DateTime.Now.Year ERP System. All rights reserved.
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm] private string Username { get; set; } = string.Empty;
    [SupplyParameterFromForm] private string Password { get; set; } = string.Empty;
    [SupplyParameterFromForm] private bool RememberMe { get; set; }

    private string? errorMessage;

    private async Task HandleLogin()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(Username) || string.IsNullOrWhiteSpace(Password))
        {
            errorMessage = "Username and password are required.";
            return;
        }

        var result = await SignInManager.PasswordSignInAsync(
            Username.Trim(),
            Password,
            RememberMe,
            lockoutOnFailure: true);

        if (result.Succeeded)
        {
            Navigation.NavigateTo("/", forceLoad: true);
        }
        else if (result.IsLockedOut)
        {
            errorMessage = "Your account has been locked out. Please try again later.";
        }
        else
        {
            errorMessage = "Invalid username or password.";
        }
    }
}