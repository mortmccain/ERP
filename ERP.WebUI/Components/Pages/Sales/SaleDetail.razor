    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
    }

    // ── Permission helpers ────────────────────────────────────────────────

    private bool CanSubmit()
    {
        if (sale is null || sale.Status != "Draft") return false;
        if (!isAdminOrManager && sale.CreatedByUserId != currentUserId) return false;
        return true;
    }

    private bool CanApprove() =>
        sale is not null && sale.Status == "Pending" && isAdminOrManager;

    private bool CanCancel()
    {
        if (sale is null) return false;
        if (sale.Status is "Cancelled" or "Shipped" or "Invoiced") return false;
        if (isAdmin) return sale.Status is "Draft" or "Pending" or "Approved";
        if (isManager) return sale.Status is "Draft" or "Pending";
        return sale.Status == "Draft" && sale.CreatedByUserId == currentUserId;
    }

    private bool CanShip() => sale is not null && sale.Status == "Approved" && isAdminOrManager;

    private bool CanInvoice() => sale is not null && sale.Status == "Shipped" && isAdminOrManager;

    // ── Display helpers ───────────────────────────────────────────────────

    private bool IsStepCompleted(string stepStatus)
    {
        if (sale is null) return false;
        var order = StatusSteps.Keys.ToArray();
        return Array.IndexOf(order, stepStatus) < Array.IndexOf(order, sale.Status);
    }

    private DateTime? GetStepTimestamp(string stepStatus) => stepStatus switch
    {
        "Draft" => sale?.CreatedAtUtc,
        "Pending" => sale?.SubmittedAtUtc,
        "Approved" => sale?.ApprovedAtUtc,
        "Shipped" => sale?.ShippedAtUtc,
        "Invoiced" => sale?.InvoicedAtUtc,
        _ => null
    };

    private static BadgeStyle GetStatusBadgeStyle(string status) => status switch
    {
        "Draft" => BadgeStyle.Secondary,
        "Pending" => BadgeStyle.Warning,
        "Approved" => BadgeStyle.Success,
        "Shipped" => BadgeStyle.Info,
        "Invoiced" => BadgeStyle.Primary,
        "Cancelled" => BadgeStyle.Danger,
        _ => BadgeStyle.Secondary
    };

    private void Notify(Radzen.NotificationSeverity severity, string summary, string detail) =>
        NotificationService.Notify(new Radzen.NotificationMessage
        {
            Severity = severity,
            Summary = summary,
            Detail = detail,
            Duration = severity == Radzen.NotificationSeverity.Error ? 6000 : 4000
        });
}