@page "/"
@attribute [Authorize]
@using ERP.Application.Common.Interfaces
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject ICurrentUserService CurrentUser

<PageTitle>Dashboard - ERP</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H3" class="mb-4">
    Welcome back, @CurrentUser.FullName
</RadzenText>

<div class="row">
    <div class="col-md-6 col-lg-3 mb-4">
        <RadzenCard>
            <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenText TextStyle="TextStyle.H2" TagName="TagName.Span" class="text-primary">--</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1" ThemeColor="TextColor.Secondary">Total Sales</RadzenText>
            </RadzenStack>
        </RadzenCard>
    </div>
    <div class="col-md-6 col-lg-3 mb-4">
        <RadzenCard>
            <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenText TextStyle="TextStyle.H2" TagName="TagName.Span" class="text-success">--</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1" ThemeColor="TextColor.Secondary">Active Customers</RadzenText>
            </RadzenStack>
        </RadzenCard>
    </div>
    <div class="col-md-6 col-lg-3 mb-4">
        <RadzenCard>
            <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenText TextStyle="TextStyle.H2" TagName="TagName.Span" class="text-warning">--</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1" ThemeColor="TextColor.Secondary">Pending Sales</RadzenText>
            </RadzenStack>
        </RadzenCard>
    </div>
    <div class="col-md-6 col-lg-3 mb-4">
        <RadzenCard>
            <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenText TextStyle="TextStyle.H2" TagName="TagName.Span" class="text-danger">--</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1" ThemeColor="TextColor.Secondary">Cancelled</RadzenText>
            </RadzenStack>
        </RadzenCard>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H5" class="mb-3">Quick Actions</RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap">
                <RadzenLink Path="/sales/create">
                    <RadzenButton Text="Create New Sale" Icon="add_shopping_cart" ButtonStyle="ButtonStyle.Primary" />
                </RadzenLink>
                <RadzenLink Path="/sales">
                    <RadzenButton Text="View All Sales" Icon="shopping_cart" ButtonStyle="ButtonStyle.Secondary" />
                </RadzenLink>
                <RadzenLink Path="/customers">
                    <RadzenButton Text="Manage Customers" Icon="people" ButtonStyle="ButtonStyle.Secondary" />
                </RadzenLink>
                <AuthorizeView Roles="Admin">
                    <RadzenLink Path="/admin/users">
                        <RadzenButton Text="User Management" Icon="manage_accounts" ButtonStyle="ButtonStyle.Info" />
                    </RadzenLink>
                </AuthorizeView>
            </RadzenStack>
        </RadzenCard>
    </div>
</div>