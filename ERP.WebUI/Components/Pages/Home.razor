@page "/"
@attribute [Authorize]

@implements IAsyncDisposable

@using ERP.Application.Common.Interfaces
@using ERP.Application.Dashboard.DTOs
@using ERP.Application.Dashboard.Queries.GetDashboardStats
@using MediatR
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject ISender Mediator
@inject ICurrentUserService CurrentUser
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Dashboard - ERP</PageTitle>

<HeadContent>
    <style>
            .action-tile {
                transition: all 0.2s ease;
                cursor: pointer;
                padding: 1rem;
                border-radius: var(--rz-border-radius);
                border: 1px solid transparent;
            }

                .action-tile:hover,
                .action-tile:active {
                    background: var(--rz-panelmenu-item-hover-background-color);
                    border-color: gray;
                    color: gray;
                    transform: translateX(4px);
                }

                    .action-tile:hover .rz-icon,
                    .action-tile:hover RadzenText {
                        color: var(--rz-primary);
                    }

        .stat-value { font-size: 1.75rem; font-weight: 700; line-height: 1; }

            .summary-card {
                transition: transform 0.18s ease, box-shadow 0.18s ease;
                cursor: default;
            }

                .summary-card:hover {
                    transform: scale(1.03);
                    box-shadow: 0 12px 2px rgba(49, 45, 47, 0.8);
                }


            .status-chart .rz-legend-bottom {
                bottom: -50px !important;
            }
    </style>
</HeadContent>

@* ── Loading ── *@
@if (isLoading)
{
    <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center"
                 style="height: 50vh;" Gap="1rem">
        <RadzenProgressBarCircular ShowValue="false"
                                   Mode="ProgressBarMode.Indeterminate"
                                   Size="ProgressBarCircularSize.Large" />
        <RadzenText ThemeColor="TextColor.Secondary">Loading dashboard…</RadzenText>
    </RadzenStack>
}
@* ── Error ── *@
else if (!string.IsNullOrEmpty(loadError))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" class="mb-3">@loadError</RadzenAlert>
}
@* ── Dashboard ── *@
else if (stats is not null)
{
    @* ════════════════════════════════════════
       WELCOME HEADER
       ════════════════════════════════════════ *@
    <RadzenStack Orientation="Orientation.Horizontal"
                 JustifyContent="JustifyContent.SpaceBetween"
                 AlignItems="AlignItems.End"
                 Wrap="FlexWrap.Wrap"
                 Gap="0.75rem"
                 class="mb-4">
        <div>
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H2" class="mb-0">
                Welcome back, @CurrentUser.FullName
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" ThemeColor="TextColor.Secondary">
                @DateTime.Now.ToString("dddd, MMMM d, yyyy")
                @if (isEmployee)
                {
                    <span> · Your personal performance</span>
                }
                else
                {
                    <span> · Company-wide overview</span>
                }
            </RadzenText>
        </div>
        @* Total revenue — prominent but not a card *@
        <div style="text-align: right;">
            <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary"
                        style="display: block; letter-spacing: .06em; text-transform: uppercase;">
                Total Revenue
            </RadzenText>
            <span style="font-size: 1.9rem; font-weight: 800; color: var(--rz-success);">
                @FormatMoney(stats.TotalRevenue)
            </span>
            <span style="font-size: 0.85rem; color: var(--rz-text-secondary-color); margin-left: 3px;">
                @stats.Currency
            </span>
        </div>
    </RadzenStack>

    @* ════════════════════════════════════════
       TOP ROW — 6-Column Summary Cards Grid
       ════════════════════════════════════════ *@
  <RadzenRow Gap="7" style="margin-bottom: 1rem;">
        @* Total Sales *@
        <RadzenColumn Size="12" SizeMD="6" SizeLG="2">
            <RadzenCard class="summary-card" style="border-top: 3px solid var(--rz-primary); height: 100%;">
                <RadzenStack Gap="0.4rem">
                    <RadzenIcon Icon="receipt_long"
                                style="color: var(--rz-primary); font-size: 1.5rem;" />
                    <span class="stat-value" style="color: var(--rz-primary);">
                        @stats.TotalSalesCount
                    </span>
                    <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary">
                        Total Sales
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
        @* Draft *@
        <RadzenColumn Size="12" SizeMD="6" SizeLG="2">
            <RadzenCard class="summary-card" style="border-top: 3px solid var(--rz-info); height: 100%;">
                <RadzenStack Gap="0.4rem">
                    <RadzenIcon Icon="edit_note"
                                style="color: var(--rz-text-secondary-color); font-size: 1.5rem;" />
                    <span class="stat-value" style="color: var(--rz-text-secondary-color);">
                        @stats.DraftSalesCount
                    </span>
                    <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary">
                        Draft
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
        @* Pending *@
        <RadzenColumn Size="12" SizeMD="6" SizeLG="2">
            <RadzenCard class="summary-card" style="border-top: 3px solid var(--rz-warning); height: 100%;">
                <RadzenStack Gap="0.4rem">
                    <RadzenIcon Icon="hourglass_empty"
                                style="color: var(--rz-warning); font-size: 1.5rem;" />
                    <span class="stat-value" style="color: var(--rz-warning);">
                        @stats.PendingSalesCount
                    </span>
                    <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary">
                        Pending
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
        @* Approved *@
        <RadzenColumn Size="12" SizeMD="6" SizeLG="2">
            <RadzenCard class="summary-card" style="border-top: 3px solid var(--rz-success); height: 100%;">
                <RadzenStack Gap="0.4rem">
                    <RadzenIcon Icon="check_circle"
                                style="color: var(--rz-success); font-size: 1.5rem;" />
                    <span class="stat-value" style="color: var(--rz-success);">
                        @stats.ApprovedSalesCount
                    </span>
                    <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary">
                        Approved
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
        @* Cancelled *@
        <RadzenColumn Size="12" SizeMD="6" SizeLG="2">
            <RadzenCard class="summary-card" style="border-top: 3px solid var(--rz-danger); height: 100%;">
                <RadzenStack Gap="0.4rem">
                    <RadzenIcon Icon="cancel"
                                style="color: var(--rz-danger); font-size: 1.5rem;" />
                    <span class="stat-value" style="color: var(--rz-danger);">
                        @stats.CancelledSalesCount
                    </span>
                    <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary">
                        Cancelled
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
        @* Active Customers *@
        <RadzenColumn Size="12" SizeMD="6" SizeLG="2">
            <RadzenCard class="summary-card" style="border-top: 3px solid #9c27b0; height: 100%;">
                <RadzenStack Gap="0.4rem">
                    <RadzenIcon Icon="people" style="color: #9c27b0; font-size: 1.5rem;" />
                    <span class="stat-value" style="color: #9c27b0;">
                        @stats.ActiveCustomersCount
                    </span>
                    <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary">
                        Active Customers
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    @* ════════════════════════════════════════
       MIDDLE SECTION — Split Layout 9/3
       ════════════════════════════════════════ *@
    <RadzenRow Gap="3" class="mb-4">
        @* Left Column (Size 9) — Revenue Charts *@
        <RadzenColumn Size="12" SizeLG="9">
            <RadzenStack Gap="3">
                @* 5-Year Revenue Distribution Pie *@
                <RadzenCard style="height: 400px;">
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H5" class="mb-0">
                        5-Year Revenue Distribution
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary"
                                style="display: block; margin-bottom: 0.5rem;">
                        @(DateTime.Now.Year - 4)–@DateTime.Now.Year
                        · @(isEmployee ? "your sales" : "all sales")
                        · excluding cancelled
                    </RadzenText>
                    @if (stats.YearlyData.All(y => y.TotalAmount == 0))
                    {
                        <RadzenStack AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.Center"
                                     style="height: 300px;" Gap="0.5rem">
                            <RadzenIcon Icon="donut_large"
                                        style="font-size: 13rem; color: var(--rz-text-secondary-color);" />
                            <RadzenText ThemeColor="TextColor.Secondary">No revenue data yet</RadzenText>
                        </RadzenStack>
                    }
                    else
                    {
                        <RadzenChart style="height: 310px;">
                            <RadzenPieSeries Data="@stats.YearlyData.Where(y => y.TotalAmount > 0).ToList()"
                                             Title="Revenue"
                                             CategoryProperty="YearLabel"
                                             ValueProperty="TotalAmount">
                            </RadzenPieSeries>
                            <RadzenLegend Position="LegendPosition.Bottom" />
                        </RadzenChart>
                    }
                </RadzenCard>

                @* Year-over-Year Revenue Column *@
                <RadzenCard style="height: 400px;">
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H5" class="mb-0">
                        Revenue by Year
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary"
                                style="display: block; margin-bottom: 0.5rem;">
                        Last 5 years · @stats.Currency · excluding cancelled
                    </RadzenText>
                    <RadzenChart style="height: 310px;">
                        <RadzenColumnSeries Data="@stats.YearlyData"
                                            Title="@YearlyRevenueTitle"
                                            CategoryProperty="YearLabel"
                                            ValueProperty="TotalAmount">
                        </RadzenColumnSeries>
                        <RadzenCategoryAxis Padding="20" />
                        <RadzenValueAxis FormatString="{0:N0}">
                            <RadzenGridLines Visible="true" />
                        </RadzenValueAxis>
                        <RadzenLegend Position="LegendPosition.Top" />
                    </RadzenChart>
                </RadzenCard>

                @* Monthly Revenue Line Chart *@
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H5" class="mb-0">
                        Monthly Revenue — @DateTime.Now.Year
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary"
                                style="display: block; margin-bottom: 0.5rem;">
                        @stats.Currency · excluding cancelled ·
                        @(isEmployee ? "your sales only" : "all sellers combined")
                    </RadzenText>
                    <RadzenChart style="height: 270px;">
                        <RadzenLineSeries Data="@stats.CurrentYearMonthlyData"
                                          Title="@MonthlyRevenueTitle"
                                          CategoryProperty="MonthLabel"
                                          ValueProperty="TotalAmount">
                            <RadzenSeriesDataLabels Visible="false" />
                            <RadzenMarkers MarkerType="MarkerType.Circle" />
                        </RadzenLineSeries>
                        <RadzenCategoryAxis Padding="20" />
                        <RadzenValueAxis FormatString="{0:N0}">
                            <RadzenGridLines Visible="true" />
                        </RadzenValueAxis>
                        <RadzenLegend Position="LegendPosition.Top" />
                    </RadzenChart>
                </RadzenCard>
            </RadzenStack>
        </RadzenColumn>

        @* Right Column (Size 3) — Stacked Charts Vertically *@
        <RadzenColumn Size="12" SizeLG="3">
            <RadzenStack Gap="3">
                @* Sales by Status Donut (Top) *@
                <RadzenCard style="height: 400px;">
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H5" class="mb-0">
                        Sales by Status
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary"
                                style="display: block;">
                        Current breakdown — all time
                    </RadzenText>
                    @if (!stats.StatusBreakdown.Any())
                    {
                        <RadzenStack AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.Center"
                                     style="height: 400px;" Gap="0.5rem">
                            <RadzenIcon Icon="pie_chart"
                                        style="font-size: 13rem; color: var(--rz-text-secondary-color);" />
                            <RadzenText ThemeColor="TextColor.Secondary">No sales yet</RadzenText>
                        </RadzenStack>
                    }
                    else
                    {
                        <RadzenChart class="status-chart"
                            style="height: 260px;">
                            <RadzenDonutSeries Data="@stats.StatusBreakdown"
                                               Title="Count"
                                               CategoryProperty="Status"
                                               ValueProperty="Count">
                            </RadzenDonutSeries>
                            <RadzenLegend Position="LegendPosition.Bottom" />
                        </RadzenChart>
                    }
                </RadzenCard>

                @* Quick Actions (Bottom) *@
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H6" class="mb-3">Quick Actions</RadzenText>
                    <RadzenStack Gap="4">
                        <div class="action-tile rz-panelmenu-item"
                             @onclick="@(() => Navigation.NavigateTo("/sales/create"))">
                            <RadzenStack Gap="0.4rem">
                                <RadzenIcon Icon="add_shopping_cart"
                                            style="color: var(--rz-primary); font-size: 1.75rem;" />
                                <RadzenText TextStyle="TextStyle.Subtitle2">Create New Sale</RadzenText>
                                <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary">
                                    Start a new sales order
                                </RadzenText>
                            </RadzenStack>
                        </div>

                        <div class="action-tile rz-panelmenu-item"
                             @onclick="@(() => Navigation.NavigateTo("/sales"))">
                            <RadzenStack Gap="0.4rem">
                                <RadzenIcon Icon="shopping_cart"
                                            style="color: var(--rz-success); font-size: 1.75rem;" />
                                <RadzenText TextStyle="TextStyle.Subtitle2">View All Sales</RadzenText>
                                <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary">
                                    Browse and manage orders
                                </RadzenText>
                            </RadzenStack>
                        </div>

                        <div class="action-tile rz-panelmenu-item"
                             @onclick="@(() => Navigation.NavigateTo("/customers"))">
                            <RadzenStack Gap="0.4rem">
                                <RadzenIcon Icon="people"
                                            style="color: #9c27b0; font-size: 1.75rem;" />
                                <RadzenText TextStyle="TextStyle.Subtitle2">Manage Customers</RadzenText>
                                <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary">
                                    View and add customers
                                </RadzenText>
                            </RadzenStack>
                        </div>

                        <AuthorizeView Roles="Admin,Manager">
                            <div class="action-tile rz-panelmenu-item"
                                 @onclick="@(() => Navigation.NavigateTo("/admin/users"))">
                                <RadzenStack Gap="0.4rem">
                                    <RadzenIcon Icon="manage_accounts"
                                                style="color: var(--rz-info); font-size: 1.75rem;" />
                                    <RadzenText TextStyle="TextStyle.Subtitle2">User Management</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary">
                                        Create and manage users
                                    </RadzenText>
                                </RadzenStack>
                            </div>
                        </AuthorizeView>
                    </RadzenStack>
                </RadzenCard>

            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private DashboardStatsDto? stats;
    private bool isLoading = true;
    private string loadError = string.Empty;
    private bool isEmployee;
    private Guid currentUserId;
    private IReadOnlyList<string> currentUserRoles = Array.Empty<string>();

    private DotNetObjectReference<object>? _dotNetRef;

    // Fixed titles for Radzen chart components
    private string YearlyRevenueTitle => stats is not null ? $"Revenue ({stats.Currency})" : "Revenue";
    private string MonthlyRevenueTitle => stats is not null ? $"Revenue ({stats.Currency})" : "Revenue";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        var user = authState.User;

        bool isAdmin = user.IsInRole("Admin");
        bool isManager = user.IsInRole("Manager");
        bool isReadOnly = user.IsInRole("ReadOnly");
        isEmployee = !isAdmin && !isManager && !isReadOnly;

        currentUserId = CurrentUser.UserId;

        var roles = new List<string>();
        if (isAdmin) roles.Add("Admin");
        if (isManager) roles.Add("Manager");
        if (isReadOnly) roles.Add("ReadOnly");
        if (isEmployee) roles.Add("Employee");
        currentUserRoles = roles.AsReadOnly();

        await LoadStats();
    }

    private async Task LoadStats()
    {
        isLoading = true;
        loadError = string.Empty;
        try
        {
            var result = await Mediator.Send(new GetDashboardStatsQuery
            {
                RequestedByUserId = currentUserId,
                UserRoles = currentUserRoles
            });

            if (result.IsSuccess)
                stats = result.Value;
            else
                loadError = result.Error ?? "Failed to load dashboard data.";
        }
        catch (Exception ex)
        {
            loadError = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string FormatMoney(decimal amount)
    {
        if (amount >= 1_000_000_000m) return $"{amount / 1_000_000_000m:F1}B";
        if (amount >= 1_000_000m) return $"{amount / 1_000_000m:F1}M";
        if (amount >= 1_000m) return $"{amount / 1_000m:F1}K";
        return amount.ToString("N0");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create<object>(this);
            await JS.InvokeVoidAsync("connectToHub", _dotNetRef, "/notificationHub", "OnDataRefresh");
        }
    }

    [JSInvokable]
    public async Task OnDataRefresh(string dataType)
    {
        if (dataType == "Dashboard")
        {
            await LoadStats();
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
    }

}